# Development template only. These values are public examples, not production
# credentials. Create a separate secret-managed configuration for deployment.

# Gateway
PORT=4310
HOST=127.0.0.1
HARBOR_GATEWAY_PORT=4311
HARBOR_GATEWAY_BIND_HOST=127.0.0.1
AUTH_MODE=dev
DATABASE_URL=postgres://harbor:harbor@127.0.0.1:5432/harbor_desk
REDIS_URL=redis://127.0.0.1:6379
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=harbor-desk
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=miniosecret
SECRET_MASTER_KEY=replace-with-a-32-byte-base64-key
OIDC_PROVIDERS_JSON=[]
# Example provider entry: {"id":"company","displayName":"Company SSO","issuer":"https://id.example.com","audience":"harbor-desk","clientId":"harbor-desktop","roleClaim":"role","hostIdsClaim":"harbor_host_ids","authorizationEndpoint":"https://id.example.com/oauth2/authorize","tokenEndpoint":"https://id.example.com/oauth2/token","scopes":["openid","profile","email"]}
ENGINE_ENDPOINT_ALLOWLIST=engine.internal.example
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# Development-only Docker host connector. Production hosts are registered
# through the admin API and their mTLS material is never sent to the client.
DEV_ENGINE_HOST=http://127.0.0.1:2375
DEV_ENGINE_DISPLAY_NAME=Development remote engine
DEV_ENGINE_TLS=false
DEV_ENGINE_CA_FILE=
DEV_ENGINE_CERT_FILE=
DEV_ENGINE_KEY_FILE=

# Optional first connection target for the desktop build. The Electron client
# detects whether this is a Harbor Desk Gateway or Docker Engine. It does not
# imply a local listener and is not persisted as a user connection.
VITE_GATEWAY_URL=
