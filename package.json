{
  "name": "harbor-desk",
  "version": "0.3.2",
  "private": false,
  "description": "A remote Docker operations desktop client with a server-side engine gateway.",
  "license": "Apache-2.0",
  "keywords": [
    "docker",
    "containers",
    "remote",
    "electron",
    "gateway",
    "devops"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turin-dev/harbor-desk.git"
  },
  "bugs": {
    "url": "https://github.com/turin-dev/harbor-desk/issues"
  },
  "homepage": "https://github.com/turin-dev/harbor-desk#readme",
  "bin": {
    "harbor-desk": "bin/harbor-desk.mjs"
  },
  "files": [
    "bin",
    "server-payload",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present --sort run build",
    "check": "pnpm run build && pnpm -r --if-present --sort run check",
    "dev": "concurrently -k \"pnpm --filter @harbor/gateway dev\" \"pnpm --filter @harbor/desktop dev\"",
    "soak:8h": "node scripts/soak-runtime.mjs",
    "package:linux": "pnpm --filter @harbor/desktop... build && pnpm --filter @harbor/desktop package:linux",
    "package:mac": "pnpm --filter @harbor/desktop... build && pnpm --filter @harbor/desktop package:mac",
    "package:win": "pnpm --filter @harbor/desktop... build && pnpm --filter @harbor/desktop package:win",
    "npx:smoke": "node bin/harbor-desk.mjs --help",
    "prepack": "node scripts/prepare-npm-server-payload.mjs",
    "postpack": "node scripts/prepare-npm-server-payload.mjs --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/npx-bootstrap.test.mjs && pnpm -r --if-present --sort run test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
