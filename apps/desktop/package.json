{
  "name": "@harbor/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Remote-first container operations desktop client",
  "author": "Harbor Desk contributors",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "check": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "pnpm run build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && electron --import tsx/esm src/main/main.ts\"",
    "package:win": "pnpm run build && electron-builder --win nsis",
    "package:dir": "pnpm run build && electron-builder --dir",
    "start": "electron .",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@harbor/contracts": "workspace:*",
    "@harbor/ui": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.85.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.3",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.harbor.desk",
    "productName": "Harbor Desk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Harbor-Desk-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
